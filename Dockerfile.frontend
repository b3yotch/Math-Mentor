# ============================================================
# Math Mentor — Frontend (React + Vite → Nginx)
# Multi-stage: build with Node, serve with Nginx
# ============================================================

# ── Stage 1: Build ───────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /build

# Copy package files first (layer caching)
# Use a wildcard so it doesn't fail if package-lock.json is missing
COPY frontend/package.json ./
COPY frontend/package-lock.json* ./

# Install dependencies
# Use npm install as fallback if package-lock.json is missing
RUN if [ -f package-lock.json ]; then \
        npm ci --silent; \
    else \
        echo "No package-lock.json found, using npm install"; \
        npm install --silent; \
    fi

# Copy source code (after deps install for better caching)
COPY frontend/public ./public
COPY frontend/src ./src
COPY frontend/index.html ./
COPY frontend/vite.config.* ./
COPY frontend/eslint.config.* ./

# Set the API URL for production build
ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}

# Build the production bundle
RUN npm run build

# Verify build output exists
RUN ls -la dist/ && echo "Build successful!"


# ── Stage 2: Serve with Nginx ────────────────────────────────
FROM nginx:alpine AS runtime

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy our custom nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy the built frontend from builder stage
COPY --from=builder /build/dist /usr/share/nginx/html

# Health check
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:80/ || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]